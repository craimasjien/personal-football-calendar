{
  "name": "my-personal-football-calendar",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:calendar": "tsx src/main.ts",
    "verify": "tsx scripts/verify.ts",
    "sync-teams": "tsx scripts/sync-teams.ts",
    "test": "vitest run",
    "test:zones": "for z in Europe/Amsterdam UTC America/New_York Asia/Tokyo Pacific/Kiritimati; do echo \"TZ=$z\" && TZ=$z vitest run tests/ics/render.test.ts tests/source/map.test.ts || exit 1; done",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ical-generator": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
